{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/automations/(.*)",
      "destination": "/api/automations?path=$1"
    },
    {
      "source": "/api/automations",
      "destination": "/api/automations"
    },
    {
      "source": "/api/instagram/accounts/(.*)/media",
      "destination": "/api/instagram/media"
    },
    {
      "source": "/api/instagram/accounts/(.*)",
      "destination": "/api/instagram/accounts"
    },
    {
      "source": "/api/instagram/accounts",
      "destination": "/api/instagram/accounts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
