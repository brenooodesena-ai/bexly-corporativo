# ==================================================
# BEXLY — Server Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ==================================================

# ── Meta / Instagram App ──
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5173/integrations/instagram/callback
META_VERIFY_TOKEN=
META_API_VERSION=v21.0

# ── Application ──
APP_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# ── Database ──
DATABASE_URL=./server/data/bexly.db

# ── Security ──
# 32+ character random string for token encryption at rest
ENCRYPTION_KEY=
# 32+ character random string for JWT signing
JWT_SECRET=

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:5173

# ==================================================
# HOW TO GENERATE SECURE RANDOM VALUES:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==================================================
